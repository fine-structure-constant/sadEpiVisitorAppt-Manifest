[Unit]
Description=PKU appointment worker and local Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pku-appointment
Group=pku-appointment
WorkingDirectory=/home/rocky/data/service/pku-appointment
ExecStart=/home/rocky/data/service/pku-appointment/pku-appointment-linux-amd64 -config /home/rocky/data/service/pku-appointment/config.json -db /home/rocky/data/service/pku-appointment/appointments.db -mode all
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
